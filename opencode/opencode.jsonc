{
  "$schema": "https://opencode.ai/config.json",
  // Built-ins stay stock. The custom subagents are hidden from the @ menu and
  // are reserved for the orchestrator; denying them here also keeps them out
  // of the built-ins' subagent catalogs.
  "agents": {
    "build": {
      "permissions": [
        { "action": "subagent", "resource": "builder", "effect": "deny" },
        { "action": "subagent", "resource": "scout", "effect": "deny" },
        { "action": "subagent", "resource": "verifier", "effect": "deny" },
        { "action": "subagent", "resource": "reviewer", "effect": "deny" }
      ]
    },
    "plan": {
      "permissions": [
        { "action": "subagent", "resource": "builder", "effect": "deny" },
        { "action": "subagent", "resource": "scout", "effect": "deny" },
        { "action": "subagent", "resource": "verifier", "effect": "deny" },
        { "action": "subagent", "resource": "reviewer", "effect": "deny" }
      ]
    }
  },
  "providers": {
    "opencode": {
      "models": {
        "deepseek-v4.1-flash-free": {
          "limit": {
            "context": 1048576,
            "output": 384000
          }
        },
        "glm-5.3-flash-free": {
          "limit": {
            "context": 1048576,
            "output": 384000
          }
        }
      }
    }
  }
}
