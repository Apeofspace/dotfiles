{
  "$schema": "https://opencode.ai/config.json",
  "experimental": {
    // Allow the reviewer subagent to launch explore (one nesting level).
    "subagent_depth": 2
  },
  // Built-ins work inline; custom subagents (builder, builder-max, reviewer,
  // researcher) are reserved for the orchestrator. Deny removes them from the
  // built-ins' subagent catalog entirely, so they won't even try.
  "agents": {
    "build": {
      "permissions": [
        { "action": "subagent", "resource": "reviewer", "effect": "deny" },
        { "action": "subagent", "resource": "researcher", "effect": "deny" },
        { "action": "subagent", "resource": "builder-max", "effect": "deny" },
        { "action": "subagent", "resource": "builder", "effect": "deny" }
      ]
    },
    "plan": {
      "permissions": [
        { "action": "subagent", "resource": "reviewer", "effect": "deny" },
        { "action": "subagent", "resource": "researcher", "effect": "deny" },
        { "action": "subagent", "resource": "builder-max", "effect": "deny" },
        { "action": "subagent", "resource": "builder", "effect": "deny" }
      ]
    }
  },
  "providers": {
    "opencode": {
      "models": {
        "deepseek-v4.1-flash-free": {
          "limit": {
            "context": 1048576,
            "output": 384000
          }
        },
        "glm-5.3-flash-free": {
          "limit": {
            "context": 1048576,
            "output": 384000
          }
        }
      }
    }
  }
}
