{
  "$schema": "https://opencode.ai/v2/cli.json",
  "diffs": {
    "wrap": "word",
    "tree": true,
    "single": true,
    "view": "split"
  },
  "terminal": {
    "title": true,
    "copy": "select"
  },
  "prompt": {
    "paste": "full",
    "image_preview": true
  },
  "session": {
    "sidebar": "auto",
    "scrollbar": true,
    "thinking": "hide",
    "permissions": "prompt",
    "new_location": "inherit",
    "verbosity": "medium",
    "tps": true,
    "markdown": "rendered"
  },
  "animations": true,
  "tabs": {
    "scope": "cwd",
    "mode": "on",
    "indicators": "status"
  },
  "attention": {
    "notifications": true,
    "sound": true
  }
}
